# AICTE APAAR ID Platform - Backend Environment Configuration

# Set your MongoDB connection URI (Atlas or Local)
# Example: mongodb+srv://username:password@cluster.mongodb.net/apaar_aicte?retryWrites=true&w=majority
# If left empty, the application runs seamlessly in High-Performance Local / In-Memory Mode with pre-seeded AICTE student data.
MONGO_URI=

# Backend server port
PORT=5000
FLASK_ENV=development
